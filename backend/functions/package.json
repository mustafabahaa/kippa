{
  "name": "kippa-functions",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22"
  },
  "main": "dist/index.js",
  "scripts": {
    "build": "npm run lint && tsc && node esbuild.mcp.mjs",
    "lint": "eslint src mcp esbuild.mcp.mjs",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "owner-access": "node scripts/set-kippa-access.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "gcp-build": ""
  },
  "dependencies": {
    "@ai-sdk/harness": "1.0.166",
    "@ai-sdk/harness-codex": "1.0.168",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@openai/codex": "0.160.1",
    "ai": "7.0.48",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.2.5",
    "ws": "8.21.0",
    "zod": "4.4.3",
    "express": "5.3.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.9",
    "@types/express": "^5.0.6"
  }
}
