{
  "hosting": {
    "public": "frontend/web/dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/mcp",
        "function": {
          "functionId": "kippaMcp",
          "region": "us-central1"
        }
      },
      {
        "source": "/.well-known/**",
        "function": {
          "functionId": "kippaMcpAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "/authorize",
        "function": {
          "functionId": "kippaMcpAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "/token",
        "function": {
          "functionId": "kippaMcpAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "/register",
        "function": {
          "functionId": "kippaMcpAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "/revoke",
        "function": {
          "functionId": "kippaMcpAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "/mcp-auth/**",
        "function": {
          "functionId": "kippaMcpAuth",
          "region": "us-central1"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "Kippa",
        "supportEmail": "your-email@example.com"
      }
    }
  },
  "functions": {
    "source": "backend/functions",
    "runtime": "nodejs22",
    "predeploy": "npm --prefix backend/functions run build"
  }
}
