rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == householdId;
    }

    function isHouseholdOwner(householdId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/households/$(householdId)/householdInfo/info)
        && get(/databases/$(database)/documents/households/$(householdId)/householdInfo/info).data.createdBy == request.auth.uid;
    }

    function isValidAiMemory(data, householdId) {
      return data.keys().hasOnly(['id', 'householdId', 'scope', 'userId', 'kind', 'content', 'confidence', 'sourceMessageIds', 'createdAt', 'updatedAt', 'lastConfirmedAt', 'supersededBy'])
        && data.householdId == householdId
        && data.scope == 'user'
        && data.userId == request.auth.uid
        && data.kind in ['fact', 'preference', 'goal', 'decision', 'correction', 'pattern', 'outcome']
        && data.content is string
        && data.content.size() >= 3
        && data.content.size() <= 500
        && data.confidence is number
        && data.confidence >= 0
        && data.confidence <= 1
        && data.sourceMessageIds is list
        && data.sourceMessageIds.size() <= 20
        && data.createdAt is string
        && data.updatedAt is string;
    }

    match /households/{householdId} {
      // AI messages are user-authored nested records. The parent conversation
      // stores createdBy; members may only access their own conversation threads.
      match /aiConversations/{conversationId} {
        allow read: if isHouseholdMember(householdId)
          && resource.data.createdBy == request.auth.uid;
        allow create: if isHouseholdMember(householdId)
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isHouseholdMember(householdId)
          && resource.data.createdBy == request.auth.uid
          && request.resource.data.createdBy == resource.data.createdBy;

        match /messages/{messageId} {
          allow read: if isHouseholdMember(householdId)
            && get(/databases/$(database)/documents/households/$(householdId)/aiConversations/$(conversationId)).data.createdBy == request.auth.uid;
          allow create: if isHouseholdMember(householdId)
            && get(/databases/$(database)/documents/households/$(householdId)/aiConversations/$(conversationId)).data.createdBy == request.auth.uid
            && request.resource.data.conversationId == conversationId;
          allow update, delete: if false;
        }
      }

      match /aiMemories/{memoryId} {
        allow create: if isHouseholdMember(householdId)
          && request.resource.data.id == memoryId
          && isValidAiMemory(request.resource.data, householdId);
        allow read: if isHouseholdMember(householdId)
          && request.auth.uid == resource.data.userId;
        allow update: if isHouseholdMember(householdId)
          && request.auth.uid == resource.data.userId
          && request.resource.data.userId == resource.data.userId
          && request.resource.data.householdId == resource.data.householdId
          && request.resource.data.id == resource.data.id
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidAiMemory(request.resource.data, householdId);
        allow delete: if false;
      }

      // Default: only members can read/write household data.
      // (notificationSettings, fcmTokens, accounts, transactions, etc.)
      match /pendingFinancialMessages/{pendingId} {
        allow read: if isHouseholdMember(householdId);
        allow write: if false;
      }

      // Direct household collections remain member-managed. Pending message
      // records are excluded because approval must be server-validated and
      // ledger writes must be atomic.
      match /{collectionName}/{documentId} {
        allow read, write: if collectionName != 'pendingFinancialMessages'
          && collectionName != 'aiConversations'
          && collectionName != 'aiMemories'
          && isHouseholdMember(householdId);
      }

      // Household info is readable by any signed-in user (so joiners can
      // verify an id exists), creatable only by the user who will own it,
      // and editable/deletable by members.
      match /householdInfo/info {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isHouseholdMember(householdId);
      }

      // Join requests: a signed-in user may create their own pending request.
      // Only the owner may list/read all requests; a requester may read their own.
      // Status updates are server-only (Admin SDK bypasses rules).
      match /joinRequests/{requesterUid} {
        allow read: if isSignedIn()
          && (request.auth.uid == requesterUid || isHouseholdOwner(householdId));
        allow create: if isSignedIn()
          && request.auth.uid == requesterUid
          && request.resource.data.uid == requesterUid
          && request.resource.data.status == 'pending';
        allow update, delete: if false;
      }
    }

    // Shortcut credentials and deduplication receipts are server-only. The
    // client sees only redacted credential summaries through callable functions.
    match /messageIngestionCredentials/{credentialId} {
      allow read, write: if false;
    }

    match /messageIngestionReceipts/{receiptId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      // A user can read their own doc, create it on signup, and edit profile
      // fields. The membership fields (householdId, householdIds, role) are
      // server-only — EXCEPT the client may switch its active householdId to a
      // value that is already present in its own householdIds. householdIds
      // and role are immutable from the client (they must equal their prior
      // server value).
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.householdId == null
        && (!('householdIds' in request.resource.data)
            || request.resource.data.householdIds.size() == 0);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.householdIds == resource.data.householdIds
        && (
          request.resource.data.householdId == resource.data.householdId
          || (
            'householdIds' in request.resource.data
            && request.resource.data.householdId in request.resource.data.householdIds
          )
        );

      match /{document=**} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
  }
}
